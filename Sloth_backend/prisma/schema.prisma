// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password_hash     String
  is_verified       Boolean    @default(false) // Whether the user has verified their email via OTP
  otp               String?    // The 6-digit code (nullable because it's only set temporarily)
  otp_expiry        DateTime?  // When the code expires (nullable)
  subscription_tier String     @default("free") // "free" or "pro"
  created_at        DateTime   @default(now())
  
  // A User can have many Documents (1-to-many relationship)
  documents         Document[]
}

// New Document Model for Phase 1.3/1.4
model Document {
  id          String   @id @default(uuid())
  title       String   // e.g. "Attention Is All You Need"
  file_path   String   // The path where the PDF is stored (e.g. "uploads/12345.pdf")
  status      String   @default("pending") // "pending", "processing", "processed", "failed"
  
  source      String   @default("local") // "local" or "arxiv"
  arxiv_id    String?  // The unique arXiv identifier if fetched from arXiv
  
  // Foreign Key linking this document back to the User
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  created_at  DateTime @default(now())
}
